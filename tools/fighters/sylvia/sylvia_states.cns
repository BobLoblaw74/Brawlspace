;---------------------------------------------------------------------------
; Wheel of Fortune (QCB+B) - she draws a card at random and it comes true:
;   The Star: heals 100 life      The Sun: +500 power
;   The Fool: she stumbles and loses 40 life
;---------------------------------------------------------------------------
[Statedef 1610]
type    = S
movetype= I
physics = S
velset = 0,0
anim = 1650
ctrl = 0
sprpriority = 2

[State 1610, Draw]
type = VarSet
trigger1 = Time = 0
var(40) = Random % 3

[State 1610, Card]
type = Explod
trigger1 = AnimElem = 3
anim = 1670 + var(40)
pos = 20, -470
postype = p1
bindtime = -1
removetime = 40
sprpriority = 4
ownpal = 1

[State 1610, Voice]
type = PlaySnd
trigger1 = AnimElem = 3
value = 0, 3

[State 1610, The Star]
type = LifeAdd
trigger1 = AnimElem = 3 && var(40) = 0
value = 100

[State 1610, The Sun]
type = PowerAdd
trigger1 = AnimElem = 3 && var(40) = 1
value = 500

[State 1610, The Fool]
type = LifeAdd
trigger1 = AnimElem = 3 && var(40) = 2
value = -40
kill = 0

[State 1610, Stumble]
type = ChangeAnim
trigger1 = AnimElem = 4 && var(40) = 2
value = 5000

[State 1610, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


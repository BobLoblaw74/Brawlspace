 Clsn2[1] = -10,-374,50,-300
7400,2, 0,0, 10
Loopstart
Clsn2: 2
 Clsn2[0] = -60,0,60,-360
 Clsn2[1] = -10,-441,50,-360
7400,3, 0,0, 60

[Begin Action 43]

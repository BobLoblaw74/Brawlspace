 Clsn2[1] = -10,-373,48,-305
7400,1, 0,0, 12
Clsn2: 2
 Clsn2[0] = -57,0,57,-286
 Clsn2[1] = -10,-356,48,-286
7400,2, 0,0, 10
Loopstart
Clsn2: 2
 Clsn2[0] = -57,0,57,-343
 Clsn2[1] = -10,-420,48,-343
7400,3, 0,0, 60


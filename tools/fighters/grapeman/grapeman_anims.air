 Clsn2[0] = -40,0,76,-320
 Clsn2[1] =   0,-376,48,-320
 Clsn2[2] =  60,-305,158,-252
7200,1, 0,0, 4
7200,2, 0,0, 3
7200,2, 0,0, 2

; Stand heavy kick: chamber the knee, kick, back to the stance. KFM's state 240
; hits whenever a frame has a Clsn1 and nudges him forward at AnimElem = 7, so
; this stays under 7 elements. 25 ticks, kick out on ticks 7-14 like KFM's.
[Begin Action 240]
Clsn2Default: 2
 Clsn2[0] = -40,0,76,-320
 Clsn2[1] =   0,-376,48,-320
7200,0, 0,0, 2
Clsn2: 3
 Clsn2[0] = -60,0,60,-320
 Clsn2[1] = -20,-376,40,-320
 Clsn2[2] =  40,-260,105,-60
7200,3, 0,0, 5
Clsn1: 1
 Clsn1[0] = 100,-340,188,-254
Clsn2: 4
 Clsn2[0] = -60,0,40,-320
 Clsn2[1] = -20,-376,40,-320
 Clsn2[2] =  20,-340,188,-250
 Clsn2[3] = -30,-120,20,0
7200,4, 0,0, 8
Clsn2: 3
 Clsn2[0] = -60,0,60,-320
 Clsn2[1] = -20,-376,40,-320
 Clsn2[2] =  40,-260,105,-60
7200,3, 0,0, 4
Clsn2: 2
 Clsn2[0] = -40,0,76,-320
 Clsn2[1] =   0,-376,48,-320
7200,5, 0,0, 6


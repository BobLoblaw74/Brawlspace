;---------------------------------------------------------------------------
; Hand-drawn sheet idle_crouch.jpg -> sprites 7600,0-5: four idle poses (the stance
; widens and narrows), half-crouch, crouching. These replace KFM's actions 0, 10,
; 11 and 12 (same hurtboxes; 10 and 12 keep KFM's 4 ticks, since states 10/12 end
; with them).
;---------------------------------------------------------------------------
[Begin Action 0]
Clsn2Default: 2
 Clsn2[0] = -52,0,64,-316
 Clsn2[1] =   20,-316,-28,-372
7600,0, 0,0, 10
7600,1, 0,0, 8
7600,2, 0,0, 12
7600,3, 0,0, 8

; Stand to crouch
[Begin Action 10]
Clsn2: 2
 Clsn2[0] = -48,0,68,-260
 Clsn2[1] =  -28,-324,24,-260
7600,4, 0,0, 4

; Crouching

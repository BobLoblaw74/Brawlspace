 Clsn2[1] =  -24,-248,24,-192
7600,5, 0,0, 1

; Crouch to stand
[Begin Action 12]
Clsn2: 2
 Clsn2[0] = -48,0,68,-260
 Clsn2[1] =  -28,-324,24,-260
7600,4, 0,0, 4

;---------------------------------------------------------------------------
; Hand-drawn sheet walk.jpg -> sprites 7500,0-5. 0-2 walk forward; 3-5 were drawn
; facing left and are mirrored, then played in reverse to walk back. Each cycle
; ping-pongs its three poses so it never pops back to the first. These replace
; KFM's actions 20 and 21 (same hurtboxes).
;---------------------------------------------------------------------------
[Begin Action 20]
Clsn2Default: 2
 Clsn2[0] = -56,0,64,-324
 Clsn2[1] =   24,-324,-28,-384
7500,0, 0,0, 7
7500,1, 0,0, 7
7500,2, 0,0, 7
7500,1, 0,0, 7

[Begin Action 21]
Clsn2Default: 2
 Clsn2[0] = -56,0,64,-324
 Clsn2[1] =   24,-324,-28,-384
7500,5, 0,0, 7
7500,4, 0,0, 7
7500,3, 0,0, 7
7500,4, 0,0, 7

;---------------------------------------------------------------------------
; Hand-drawn sheet jump.jpg -> sprites 7400,0-4: crouch, rise, apex, fall, land.
; These replace KFM's actions 40/41/42/43/47. Airborne poses are anchored at their
; lowest point (physics sets the height). A neutral jump is ~41 ticks
; (jump.neu y -36, yaccel 1.76), apex at ~20.
;---------------------------------------------------------------------------

; Jump start (state 40 takes off when this ends: keep KFM's 3 ticks)
[Begin Action 40]
Clsn2Default: 2
 Clsn2[0] = -60,0,70,-290
 Clsn2[1] = -20,-340,40,-290
7400,0, 0,0, 3

; Neutral jump: rise, apex, fall (holds until landing)
[Begin Action 41]
Clsn2: 2
 Clsn2[0] = -70,-20,60,-300
 Clsn2[1] = -20,-350,40,-300
7400,1, 0,0, 13
Clsn2: 2
 Clsn2[0] = -70,0,60,-300
 Clsn2[1] = -20,-350,40,-300
7400,2, 0,0, 10
Loopstart
Clsn2: 2
 Clsn2[0] = -70,0,70,-350
 Clsn2[1] = -20,-400,40,-350
7400,3, 0,0, 60

; Forward and back jumps use the same drawing
[Begin Action 42]
Clsn2: 2
 Clsn2[0] = -70,-20,60,-300
 Clsn2[1] = -20,-350,40,-300
7400,1, 0,0, 13
Clsn2: 2
 Clsn2[0] = -70,0,60,-300
 Clsn2[1] = -20,-350,40,-300
7400,2, 0,0, 10
Loopstart
Clsn2: 2
 Clsn2[0] = -70,0,70,-350
 Clsn2[1] = -20,-400,40,-350
7400,3, 0,0, 60

[Begin Action 43]
Clsn2: 2
 Clsn2[0] = -70,-20,60,-300
 Clsn2[1] = -20,-350,40,-300
7400,1, 0,0, 13
Clsn2: 2
 Clsn2[0] = -70,0,60,-300
 Clsn2[1] = -20,-350,40,-300
7400,2, 0,0, 10
Loopstart
Clsn2: 2
 Clsn2[0] = -70,0,70,-350
 Clsn2[1] = -20,-400,40,-350
7400,3, 0,0, 60

; Landing (state 52 returns to the stance when this ends: KFM's 3 ticks)
[Begin Action 47]
Clsn2Default: 2
 Clsn2[0] = -60,0,70,-300
 Clsn2[1] = -20,-350,40,-300
7400,4, 0,0, 3

;---------------------------------------------------------------------------
; Hand-drawn sheet punch_kick.jpg -> sprites 7200,0-5 (0-2 light punch, 3-5 heavy
; kick). These replace KFM's actions 200 and 240; hitboxes follow the drawn fist
; and boot.
;---------------------------------------------------------------------------

; Stand light punch. KFM's state 200 turns its HitDef on at AnimElem = 3 (the
; punch); total length stays KFM's 12 ticks.

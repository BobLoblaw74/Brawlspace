Clsn2: 2
 Clsn2[0] = -40,-30,64,-330
 Clsn2[1] =   4,-400,60,-330
7040,3, 0,0, 10
Clsn2: 2
 Clsn2[0] = -44,-60,64,-320
 Clsn2[1] =   0,-380,56,-320
7040,4, 0,0, 11
Clsn2: 2
 Clsn2[0] = -44,-20,64,-350
 Clsn2[1] =   0,-410,56,-350
7040,5, 0,0, 7
Loopstart
Clsn2Default: 2
 Clsn2[0] = -56,0,64,-320
 Clsn2[1] =   0,-380,56,-320
7040,6, 0,0, 4

[Begin Action 43]
Clsn2: 2
 Clsn2[0] = -40,-30,64,-330
 Clsn2[1] =   4,-400,60,-330
7040,3, 0,0, 10
Clsn2: 2
 Clsn2[0] = -44,-60,64,-320
 Clsn2[1] =   0,-380,56,-320
7040,4, 0,0, 11
Clsn2: 2
 Clsn2[0] = -44,-20,64,-350
 Clsn2[1] =   0,-410,56,-350
7040,5, 0,0, 7
Loopstart
Clsn2Default: 2
 Clsn2[0] = -56,0,64,-320
 Clsn2[1] =   0,-380,56,-320
7040,6, 0,0, 4


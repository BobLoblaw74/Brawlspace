 Clsn2[1] = -40,-376,20,-320
 Clsn2[2] =  20,-435,252,-300
 Clsn2[3] = -30,-120,20,0
7200,4, 0,0, 8
Clsn2: 3
 Clsn2[0] = -60,0,60,-320
 Clsn2[1] = -20,-376,40,-320
 Clsn2[2] =  40,-300,130,-90
7200,3, 0,0, 4
Clsn2: 2
 Clsn2[0] = -40,0,76,-320
 Clsn2[1] =   0,-376,48,-320
7200,5, 0,0, 6


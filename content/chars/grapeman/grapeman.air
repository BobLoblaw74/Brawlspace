 Clsn2[1] = -20,-350,40,-300
7400,2, 0,0, 10
Loopstart
Clsn2: 2
 Clsn2[0] = -70,0,70,-350
 Clsn2[1] = -20,-400,40,-350
7400,3, 0,0, 60

